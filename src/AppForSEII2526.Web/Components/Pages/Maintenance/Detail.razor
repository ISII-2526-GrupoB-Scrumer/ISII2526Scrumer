@page "/maintenance/detalle/{Id:int}"
@inject HttpClient Http

<h3>Reserva Confirmada</h3>

@if (detalle != null)
{
    <div class="alert alert-success">
        <p><strong>Cliente:</strong> @detalle.ApplicationUser</p>
        <p><strong>Dirección:</strong> @detalle.ClientAddress</p>
        <p><strong>Fecha:</strong> @detalle.Date.ToShortDateString()</p>
        <p><strong>Método de Pago:</strong> @detalle.PaymentMethod</p>
        <p><strong>Precio Total:</strong> @detalle.TotalPrice.ToString("C")</p>
    </div>

    <h4>Servicios Contratados</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Mantenimiento</th>
                <th>Precio</th>
                <th>Días</th>
                <th>Comentario</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in detalle.ReservaItems)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.NumberOfDays</td>
                    <td>@item.Comentarios</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Cargando recibo...</p>
}

@code {
    [Parameter] public int Id { get; set; }
    private MaintenanceDetailDTO detalle;

    protected override async Task OnInitializedAsync()
    {
        detalle = await Http.GetFromJsonAsync<MaintenanceDetailDTO>($"api/Booking/GetBooking?id={Id}");
    }
}