@page "/maintenance/selectcarsformaintenance"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectCarsForMaintenance> logger
@inject MaintenanceStateContainer maintenanceState
@inject NavigationManager navigation

<h3>Selecciona mantenimientos</h3>

<div class="container-fluid">
    <!-- Errores -->
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p>@errors</p>
    </div>

    <div class="row">
        <div class="col-8">
            <!-- Filtros -->
            <div class="row mb-3">
                <div class="col">
                    <div class="input-group">
                        <span class="input-group-text">Tipo de mantenimiento</span>
                        <input type="text" class="form-control" placeholder="Tipo" @bind="typeFilter" />
                    </div>
                </div>

                <div class="col">
                    <button class="btn btn-primary w-100" @onclick="SearchMaintenances">
                        Buscar
                    </button>
                </div>
            </div>

            <!-- Listado de mantenimientos -->
            <div class="row">
                @if (maintenances == null)
                {
                    <p>Cargando mantenimientos...</p>
                }
                else
                {
                    <div class="table-responsive mh-100">
                        <table class="table table-hover table-condensed">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Descripción</th>
                                    <th>Precio</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var maintenance in maintenances)
                                {
                                    <tr>
                                        <td>@maintenance.Type</td>
                                        <td>@maintenance.Name</td>
                                        <td>@maintenance.Price €</td>
                                        <td>@maintenance.NumberOfDays</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" @onclick="() => AddMaintenance(maintenance)">
                                                Añadir
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Carrito -->
        <div class="col-3" hidden="@hideCart">
            <h3>Carrito</h3>

            @foreach (var item in maintenance.MaintenanceItems)
            {
                <div class="row mb-2">
                    <button class="btn btn-light w-100 text-start" @onclick="@(() => RemoveItem(item))">
                        x @item.Type (@item.MaintenanceName)
                    </button>
                </div>
            }

            <div class="row mt-3">
                <strong>Total:</strong>
                <p>@maintenanceState.TotalPrice €</p>
            </div>

            <button class="btn btn-primary w-100" @onclick="Continue">
                Continuar
            </button>
        </div>
    </div>
</div>

@code {
    private string? typeFilter;
    private ICollection<MaintenanceSelectDTO>? maintenances;
    private string errors = "";
    private bool hideErrors => string.IsNullOrEmpty(errors);

    private MaintenanceCreateDTO maintenance => maintenanceState.Maintenance;

    private bool hideCart => maintenance.MaintenanceItems.Count == 0;

    protected override async Task OnInitializedAsync()
    {
        await SearchMaintenances();
    }

    private async Task SearchMaintenances()
    {
        try
        {
            string nombre = string.IsNullOrWhiteSpace(typeFilter) ? null : typeFilter;
            string tipo = string.IsNullOrWhiteSpace(typeFilter) ? null : typeFilter;
            maintenances = await apiclient.GetMaintenancesAsync(nombre,tipo);
            errors = "";
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} ERROR: {ex}");
            errors = "Error while connecting to the system.";
        }
        StateHasChanged();
    }

    private void AddMaintenance(MaintenanceSelectDTO maintenance)
    {
        maintenanceState.AddMaintenanceToCreate(maintenance);
        StateHasChanged();
    }

    private void RemoveItem(MaintenanceItemDTO item)
    {
        maintenanceState.RemoveMaintenanceItem(item);
        StateHasChanged();
    }

    private void Continue()
    {
        navigation.NavigateTo("/maintenance/createmaintenance");
    }
}
