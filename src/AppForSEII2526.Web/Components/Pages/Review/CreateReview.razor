@page "/review/createreview"

@using AppForSEII2526
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization

@inject AppForSEII2526APIClient apiclient
@inject ReviewStateContainer reviewState
@inject NavigationManager navigation
@inject ILogger<CreateReview> logger


<h3>Crear resenyas</h3>

<EditForm Model="review" OnValidSubmit="OpenDialog">
    <DataAnnotationsValidator />
    <ValidationSummary class="alert alert-danger" />

    <div class="row alert alert-danger" hidden="@hideErrors">
        <p>Errors: @messageError</p>
    </div>

    <!-- Datos del usuario -->
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.Name" class="form-control" id="Name" />
                <label for="Name">Nombre</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.ClientId" class="form-control" id="ClientId" />
                <label for="ClientId">Nombre de usuario</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.Country" class="form-control" id="Country" />
                <label for="Country">Pais</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating">
            <InputSelect class="form-select" @bind-Value="review.DriverType" id="Drivertype">
                <option value=""></option>
                <option value="Novato">Novato</option>
                <option value="Experto">Experto</option>
            </InputSelect>

            <label for="Drivertype">Tipo de conductor</label>
        </div>

        </div>
    </div>

    <h4>Coches para resenyar</h4>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover">
            <thead>
                <tr>
                    <th>Coche</th>
                    <th>Combustible</th>
                    <th>Color</th>
                    <th>Descripcion</th>
                    <th>Valoracion (1–5)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in review.ReviewItems)
                {
                    <tr id="CreateReviewItem_@item.CarId">
                        <td>@item.Manufacturer @item.CarModel</td>
                        <td>@item.FuelType</td>
                        <td>@item.Color</td>
                        <td>
                            <InputText class="form-control"
                                      id="descripciontxt"
                                       @bind-Value="item.Description" />
                        </td>
                        <td>
                            <input class="form-control"
                                   type="text"
                                   id="ratingtxt"
                                   value="@item.Rating"
                                   inputmode="numeric"
                                   pattern="[1-5]*"
                                   @oninput="e => OnRatingChanged(e, item)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row mt-3">
        <div class="col">
            <button class="btn btn-outline-primary"
                    @onclick="ModifyCars"
                    type="button">
                Modificar coches
            </button>
        </div>

        <div class="col text-end">
            <button class="btn btn-primary" type="submit">
                Publicar resenyas
            </button>
        </div>
    </div>
</EditForm>

@if (DialogIsOpen)
{
    <Dialog Caption="Publicar resenyas"
    Message="Seguro que quieres continuar?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {

    private string messageError = "";
    private bool hideErrors => messageError.Length == 0;
    private bool DialogIsOpen;

    private ReviewCreateDTO review => reviewState.Review;

    private void ModifyCars()
    {
        navigation.NavigateTo("/review/selectcarsforreview");
    }

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;

        if (!isOk) return;

        if (review.ReviewItems.Count == 0)
        {
            messageError = "Debes de reseñar al menos un coche.";
            return;
        }

        try
        {
            var createdReview = await apiclient.CreateReviewAsync(review);

            reviewState.ReviewProcessed();

            navigation.NavigateTo($"/review/detailreview?ReviewID={createdReview.Id}");
        }
        catch (ApiException<ValidationProblemDetails> ex)
        {
            messageError = string.Join(" ", ex.Result.Errors.Values.SelectMany(e => e));
        }
        catch (ApiException)
        {
            messageError = "Error while processing your request.";
        }
    }

    protected override async Task OnInitializedAsync()
    {

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    review.Name = user.Identity.Name;
                }
            }
            review.Name = review.Name== null ? "" : review.Name;
            review.Country = review.Country == null ? "" : review.Country;
            review.DriverType = review.DriverType == null ? "" : review.DriverType;

        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private void OnRatingChanged(ChangeEventArgs e, ReviewItemDTO item)
    {
        var value = e.Value?.ToString();

        if (int.TryParse(value, out var rating))
        {
            item.Rating = rating;
        }
        else
        {
            item.Rating = 0;
        }
    }
}
