@page "/purchase/details/{Id:int}"

@using AppForSEII2526
@using AppForSEII2526.Web.API

@inject AppForSEII2526APIClient api
@inject ILogger<PurchaseDetails> logger

<h3>Purchase Details</h3>

@if (purchase == null)
{
    <p>Loading purchase...</p>
}
else
{
    <div class="container mt-3">

        <div class="card p-4">

            <h4>Purchase ID: @purchase.Id</h4>
            <hr />

            <div class="row">
                <div class="col">
                    <p><strong>Date:</strong> @purchase.PurchasingDate.DateTime.ToShortDateString()</p>
                    <p><strong>Payment Method:</strong> @purchase.PaymentMethod</p>
                    <p><strong>Driver Type:</strong> @purchase.DriverType</p>
                </div>

                <div class="col">
                    <p><strong>Delivery Dealer:</strong> @purchase.DeliveryCarDealer</p>
                    <p><strong>Country:</strong> @purchase.Country</p>
                    <p><strong>Total Price:</strong> @purchase.PurchasingPrice €</p>
                </div>
            </div>

            <hr />

            <h5>Purchased Cars</h5>

            <table class="table table-hover mt-3">
                <thead>
                    <tr>
                        <th>Model</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in purchase.PurchaseItems)
                    {
                        <tr>
                            <td>@item.CarModel</td>
                            <td>@item.Quantity</td>
                            <td>@item.PurchasingPrice €</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

        <div class="mt-3">
            <a href="/" class="btn btn-primary">Return Home</a>
        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PurchaseDetailDTO? purchase;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            purchase = await api.GetPurchaseAsync(Id);
        }
        catch (ApiException ex)
        {
            logger.LogError($"Error retrieving purchase: {ex}");
        }
    }
}

