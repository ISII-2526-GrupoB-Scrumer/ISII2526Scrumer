@page "/purchase/selectcarsforpurchase"

@using AppForSEII2526
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization

@inject AppForSEII2526APIClient api
@inject ILogger<PurchaseCars> logger
@inject PurchaseStateContainer purchaseState
@inject NavigationManager navigation



<h3>Select Cars for Purchase</h3>

<div class="container-fluid">

    <!-- ZONA DE ERRORES -->
    <div class="row alert alert-danger" role="alert" hidden="@HideErrors">
        <p>@Errors</p>
    </div>

    <div class="row">
        <!-- COLUMNA IZQUIERDA: FILTROS + LISTA DE COCHES -->
        <div class="col-8">

            <!-- FILTROS -->
            <div class="row">

                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">Model</span>
                        <input type="text" class="form-control" @bind="modelFilter" placeholder="Model name">
                    </div>
                </div>

                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">Color</span>
                        <input type="text" class="form-control" @bind="colorFilter" placeholder="Color">
                    </div>
                </div>

                <div class="col">
                    <button class="btn btn-primary" @onclick="SearchCars">Search</button>
                </div>

            </div>

            <!-- LISTADO DE COCHES -->
            <div class="row mt-3">
                @if (cars == null)
                {
                    <p>Loading cars...</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-condensed">
                            <thead>
                                <tr>
                                    <th>Model</th>
                                    <th>Manufacturer</th>
                                    <th>Color</th>
                                    <th>Price</th>
                                    <th>Add</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (cars.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No results found</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var car in cars)
                                    {
                                        <tr>
                                            <td>@car.ModelName</td>
                                            <td>@car.Manufacturer</td>
                                            <td>@car.Color</td>
                                            <td>@car.PurchasingPrice €</td>
                                            <td>
                                                <button class="btn btn-outline-secondary"
                                                        @onclick="@(() => AddCar(car))">
                                                    Add
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>

        <!-- COLUMNA DERECHA: CARRITO -->
        <div class="col-3" hidden="@HideCart">
            <h4>Purchase Cart</h4>

            @foreach (var item in purchaseState.Purchase.PurchaseItems)
            {
                <div class="row mb-2">
                    <button class="btn btn-light w-100 text-start"
                            id="removeCar_@item.CarId"
                            @onclick="@(() => RemoveItem(item))">
                        x @item.CarModel
                        (Cantidad: @item.Quantity)
                        – @item.PurchasingPrice
                    </button>
                </div>
            }

            <div class="mt-3">
                <strong>Total:</strong> @purchaseState.TotalPrice €
            </div>

            <div class="mt-3">
                <button class="btn btn-success w-100"
                        @onclick="Continue">
                    Continue
                </button>
            </div>
        </div>
    </div>

</div>

@code {

    // FILTROS
    private string? modelFilter;
    private string? colorFilter;

    // RESULTADOS BUSCADOS
    private ICollection<PurchaseSelectDTO>? cars;

    // GESTIÓN DE ERRORES
    private string Errors = "";
    private bool HideErrors => string.IsNullOrEmpty(Errors);

    // CART VISIBILITY
    private bool HideCart => purchaseState.Purchase.PurchaseItems.Count == 0;

    // --------------------------------------------
    // MÉTODOS
    // --------------------------------------------

    private void AddCar(PurchaseSelectDTO car)
    {
        purchaseState.AddCarToPurchase(car);
        StateHasChanged();
    }

    private void RemoveItem(PurchaseItemDTO item)
    {
        purchaseState.RemovePurchaseItem(item);
        StateHasChanged();
    }

    private async Task SearchCars()
    {
        try
        {
            var m = string.IsNullOrWhiteSpace(modelFilter) ? null : modelFilter;
            var c = string.IsNullOrWhiteSpace(colorFilter) ? null : colorFilter;

            cars = await api.GetCochesParaCompraAsync(m, c);

            Errors = "";
        }
        catch (ApiException ex)
        {
            logger.LogError($"Error getting cars: {ex}");
            Errors = "Error while connecting to the system.";
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await SearchCars();
    }

    private void Continue()
    {
        navigation.NavigateTo("/purchase/createpurchase");
    }
}